# ---- Platform identity (white-label defaults for the admin console itself) ----
PLATFORM_NAME=Finverge Control Plane

# ---- Database (shared PostgreSQL; microservices use logical tenant_id scoping) ----
DATABASE_URL=postgresql+psycopg2://cp:cp_password@postgres:5432/controlplane

# ---- Auth ----
JWT_SECRET=change-me-in-prod-use-a-32-byte-random-string
JWT_EXPIRE_MINUTES=480

# ---- Internal service-to-service auth (onboarding orchestration) ----
INTERNAL_API_KEY=change-me-internal-key

# ---- Service discovery (used by the gateway to route, and by tenant onboarding) ----
TENANT_SERVICE_URL=http://tenant-service:8081
BRANDING_SERVICE_URL=http://branding-service:8082
CONFIG_SERVICE_URL=http://config-service:8083
ANALYTICS_SERVICE_URL=http://analytics-service:8084

# ---- Analytical store ----
# 'postgres' today. A ClickHouse engine implements the same QueryEngine interface, so
# switching is this one value plus the new engine module - no dashboard/metric changes.
ANALYTICS_ENGINE=postgres

# ---- Dev conveniences ----
# Schema is owned by Alembic (`alembic upgrade head`). Leave this false so the models and the
# migrations cannot silently diverge; set true only for a throwaway scratch database.
AUTO_CREATE_TABLES=false
# Seed a platform admin on tenant-service startup (idempotent).
SEED_ADMIN_EMAIL=admin@finverge.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# The seeded password above is a published default, so the admin is forced to change it at
# first login. Set false only for throwaway local dev / automated tests.
SEED_ADMIN_MUST_CHANGE_PASSWORD=true
# Seed a demo tenant so the console has something to show on first run.
SEED_DEMO_TENANT=true
